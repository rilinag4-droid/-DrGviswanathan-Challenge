class Solution {
public:
    int subarrayLCM(vector<int>& nums, int k) {
        int ans = 0;

        for (int i = 0; i < nums.size(); i++) {
            long long lcm = 1;

            for (int j = i; j < nums.size(); j++) {
                lcm = std::lcm(lcm, (long long)nums[j]);

                if (lcm == k)
                    ans++;

                if (lcm > k || k % lcm != 0)
                    break;
            }
        }

        return ans;
    }
};
